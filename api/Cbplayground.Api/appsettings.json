{
  "ConnectionStrings": {
    "Default": "Data Source=data/cbplayground.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Uploads": {
    "Path": "data/uploads"
  },
  "Backup": {
    "Enabled": true,
    "Path": "data/backups",
    "TimeOfDay": "03:00",
    "RetentionDays": 30
  },
  "AllowedHosts": "*"
}
